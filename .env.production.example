# Production environment template. Copy it to .env.production and replace every
# value. `next build` also reads .env.production, so on a developer machine use
# .env.production.local for local production tests instead. Never commit real
# secrets.
#
# `npm run start:standalone` loads the file with Next.js precedence:
# .env.production.local, .env.local, .env.production, .env. Variables already
# set by systemd/a process manager take precedence.
#
# Docker Compose reads this file twice: with `--env-file` for ${...}
# substitution (POSTGRES_*, build args) and through `env_file` for the
# containers. The compose file overrides UPLOAD_DIR and the database host, so
# the values below describe a standalone installation.

# Credentials for the PostgreSQL container. POSTGRES_PASSWORD must match the
# password inside DATABASE_URL. Use a URL-safe password (letters, digits, - and
# _) or percent-encode it in the URL.
POSTGRES_USER="mono"
POSTGRES_PASSWORD="replace-with-a-url-safe-database-password"
POSTGRES_DB="mono_accessory"

# Single PostgreSQL connection string used by the app and by the build. This
# host is used by a standalone installation and by the image build on Linux.
# Docker Compose replaces the host with the `db` service for the containers.
# Use sslmode=disable when the database does not use TLS.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE?sslmode=disable"

# Session signing secret, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Template values (generate, change, example, secret-of, your-,
# random-secret) are rejected at startup.
AUTH_SECRET="generate-a-random-secret-of-at-least-32-characters"

# Public origin used for canonical URLs, metadata, sitemap and robots.
# Next.js inlines NEXT_PUBLIC_* at BUILD time, so set this before `npm run build`.
# HTTPS is required in production.
NEXT_PUBLIC_SITE_URL="https://shop.example.com"

# Admin account created by `npm run db:seed:production`.
ADMIN_MOBILE="09xxxxxxxxx"
# At least 10 characters. Placeholders are rejected by the seed and by the
# production startup check.
ADMIN_PASSWORD="choose-a-strong-password"

# Image storage driver. Only "local" is implemented.
IMAGE_STORAGE="local"

# Absolute path on persistent storage for runtime uploads. Back this up.
# Docker Compose overrides it with /data/uploads (the uploads volume).
UPLOAD_DIR="/var/lib/mono-accessory/uploads"

# Payment provider. "mock" never charges anyone; replace it before real orders.
PAYMENT_PROVIDER="mock"

# Maximum number of pooled database connections. Keep it within the
# PostgreSQL connection limit.
DB_POOL_MAX="10"

# Set to "true" only behind a reverse proxy that OVERWRITES X-Forwarded-For.
# Keep "false" for a standalone server. The Docker/Nginx deployment sets it to
# true in docker-compose.yml because deploy/nginx.example.conf overwrites the
# header with the address Nginx sees.
TRUST_PROXY="false"

# Keep false for real data. The production seed never creates demo reviews.
SEED_DEMO_REVIEWS="false"
