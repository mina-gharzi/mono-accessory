# PostgreSQL connection string (Neon or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Initial admin account created by prisma/seed.ts
ADMIN_MOBILE="09xxxxxxxxx"
ADMIN_PASSWORD="change-me"

# Public site URL used for canonical and Open Graph metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign session JWTs (at least 32 characters)
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Payment provider selector. Only "mock" is implemented for now.
PAYMENT_PROVIDER="mock"

# Image storage driver for admin uploads. Only "local" is implemented for now.
IMAGE_STORAGE="local"
