# PostgreSQL connection string (Neon or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct (unpooled) connection string used by Prisma CLI for migrations.
# Neon's pooler cannot hold the migration advisory lock, so set the URL
# without "-pooler" here. Falls back to DATABASE_URL when omitted.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Initial admin account created by prisma/seed.ts
ADMIN_MOBILE="09xxxxxxxxx"
ADMIN_PASSWORD="change-me"

# Optional demo reviews for local UI previews. Keep false (or unset) for real
# data: when true, prisma/seed.ts creates clearly marked sample reviews and
# demo customer accounts.
SEED_DEMO_REVIEWS="false"

# Public site URL used for canonical and Open Graph metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign session JWTs (at least 32 characters)
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Payment provider selector. Only "mock" is implemented for now.
PAYMENT_PROVIDER="mock"

# Image storage driver for admin uploads. Only "local" is implemented for now.
IMAGE_STORAGE="local"

# Directory for runtime uploads. Defaults to ./uploads in the project root.
# UPLOAD_DIR="./uploads"

# Set to "true" only behind a reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY="false"

# Optional maximum number of pooled database connections. Defaults to 10.
# Keep it within the connection limit of your database provider.
DB_POOL_MAX="10"

# Disposable PostgreSQL database used by integration and E2E tests.
# Its host or database name must contain "test" and it must differ from DATABASE_URL.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mono_test?sslmode=require"

# Optional base URL for Playwright. Defaults to http://localhost:3000.
E2E_BASE_URL="http://localhost:3000"
